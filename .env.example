# Copy to .env and fill in ONE LLM key. Never commit .env (it is git-ignored).
#
# LLM_PROVIDER: auto | none | anthropic | openai | gemini | groq | ollama | openai_compatible
#   auto  -> first provider whose key is set below (anthropic, openai, gemini, groq), else none
#   none  -> fully offline: extractive answers, rule-based understanding (still passes all tests)
LLM_PROVIDER=auto
# LLM_MODEL=            # optional override; defaults: anthropic claude-haiku-5-5, openai gpt-4o-mini,
                        # gemini gemini-2.5-flash, groq llama-3.3-70b-versatile

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# For any other OpenAI-compatible endpoint (Hugging Face router, Together, vLLM, LM Studio...):
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://router.huggingface.co/v1
# LLM_API_KEY=hf_...
# LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct

# EMBEDDING_PROVIDER: auto | fastembed | openai | hashing
#   auto/fastembed -> BAAI/bge-small-en-v1.5 locally via ONNX (free, no key, ~67 MB one-time download)
#   hashing        -> no download at all (air-gapped machines, CI)
EMBEDDING_PROVIDER=auto

# Optional tuning (defaults shown)
# TOP_K=4
# FILTER_WIDEN_MARGIN=0.20
# MIN_EVIDENCE=0.20
# INDEX_DIR=.index
